# AgentLens Production Environment Variables

# Runtime Environment (development, staging, production, test)
AGENTLENS_ENVIRONMENT=production

# PostgreSQL Storage
POSTGRES_USER=agentlens
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=agentlens
POSTGRES_PORT=55432
AGENTLENS_DATABASE_URL=postgresql+psycopg://agentlens:replace_with_strong_password_in_production@127.0.0.1:55432/agentlens
AGENTLENS_DB_POOL_SIZE=20
AGENTLENS_DB_MAX_OVERFLOW=10
AGENTLENS_DB_POOL_TIMEOUT=30.0

# Redis Cache & Dispatcher
REDIS_PORT=56379
AGENTLENS_REDIS_URL=redis://127.0.0.1:56379/0
AGENTLENS_REDIS_TIMEOUT=5.0

# Project Authentication & Credentials
AGENTLENS_PROJECT_ID=prod-project
AGENTLENS_PROJECT_API_KEY=prod_super_secret_api_key_minimum_16_chars
AGENTLENS_API_KEY_ID=prod-api-key

# API Gateway Server Configuration
API_PORT=8000
AGENTLENS_API_HOST=0.0.0.0
AGENTLENS_API_PORT=8000
AGENTLENS_LOG_LEVEL=INFO
AGENTLENS_LOG_FORMAT=json
AGENTLENS_MAX_REQUEST_BYTES=10485760
AGENTLENS_RATE_LIMIT=1000
AGENTLENS_RATE_WINDOW=60
AGENTLENS_CORS_ORIGINS=*

# Worker Configuration
AGENTLENS_WORKER_CONCURRENCY=1
AGENTLENS_WORKER_POLL_INTERVAL=1.0
AGENTLENS_HEARTBEAT_INTERVAL=15.0
AGENTLENS_HEARTBEAT_TTL=45.0
AGENTLENS_LEASE_DURATION=300.0
AGENTLENS_SHUTDOWN_TIMEOUT=30.0

# Next.js Dashboard
DASHBOARD_PORT=3000
AGENTLENS_GATEWAY_URL=http://127.0.0.1:8000
